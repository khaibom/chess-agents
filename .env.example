# Copy to .env for Docker Compose. Replace the contact email and Telegram user ID.
CHESS_USER_AGENT="chess-agents/0.1 (contact: you@example.com)"
TELEGRAM_ALLOWED_USER_ID=123456789

# Compose reads credentials from .secrets/openai_key and .secrets/telegram_token.
# Compose sets the database and Stockfish paths inside the container.

# Native CLI: export settings explicitly; it does not automatically load .env.
# CHESS_DB=./.local/chess-agents.sqlite3
# STOCKFISH_PATH=/path/to/your/stockfish
# OPENAI_API_KEY_FILE=./.secrets/openai_key
# TELEGRAM_BOT_TOKEN_FILE=./.secrets/telegram_token
